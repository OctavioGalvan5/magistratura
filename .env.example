# ── Base de datos (PostgreSQL) ────────────────────
# Ejemplo Supabase u otro Postgres:
DB_CONNECTION_STRING=postgresql+psycopg2://user:password@host:5432/dbname

# ── Proveedores de visión (uno alcanza — Anthropic va primero) ──
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── MinIO / S3 ────────────────────────────────────
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=avales-eleccion-2026
MINIO_SECURE=false

# ── Flask ─────────────────────────────────────────
FLASK_SECRET=cambiar-a-un-string-random-largo
