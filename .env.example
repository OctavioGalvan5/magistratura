# ── Base de datos (PostgreSQL) ────────────────────
# Workspace principal (default, --db julia):
DB_CONNECTION_STRING=postgresql+psycopg2://user:password@host:5432/dbname
# Workspace nacion (opcional, --db nacion) — apuntando a otra DB del mismo server:
DB_NACION_CONNECTION_STRING=postgresql+psycopg2://user:password@host:5432/nacion

# ── Proveedores de visión (uno alcanza — Anthropic va primero) ──
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# ── MinIO / S3 ────────────────────────────────────
MINIO_ENDPOINT=host:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=avales-eleccion-2026
MINIO_SECURE=false

# ── Flask ─────────────────────────────────────────
FLASK_SECRET=cambiar-a-un-string-random-largo
